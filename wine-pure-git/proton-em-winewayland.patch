+                            uint32_t min, uint32_t max, uint32_t ref)
+{
+    struct wayland_output *output = data;
+
+    TRACE("reference luminance: %u\n", ref);
+
+    output->pending.ref_lum = ref;
+    output->pending_flags |= WAYLAND_OUTPUT_CHANGED_REF_L;
