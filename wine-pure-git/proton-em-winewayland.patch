Subject: [PATCH 66/79] win32u: Don't return early if no monitor id is present.

Signed-off-by: Vasiliy Stelmachenok <ventureo@cachyos.org>
---
 dlls/win32u/sysparams.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
index 7233abbbba2..0619b87b7dd 100644
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -423,11 +423,11 @@ static void get_monitor_info_from_edid( struct edid_monitor_info *info, const un
     for (i = 0; i < 3; ++i)
     {
         d = w & 0x1f;
-        if (!d || d - 1 > 'Z' - 'A') return;
+        if (!d || d - 1 > 'Z' - 'A') goto skip_id;
         info->monitor_id_string[2 - i] = 'A' + d - 1;
         w >>= 5;
     }
-    if (w) return;
+    if (w) goto skip_id;
     w = edid[10] | (edid[11] << 8); /* Product code, little endian. */
     info->manufacturer = *(unsigned short *)(edid + 8);
     info->product_code = w;
@@ -435,6 +435,7 @@ static void get_monitor_info_from_edid( struct edid_monitor_info *info, const un
     info->flags = MONITOR_INFO_HAS_MONITOR_ID;
     TRACE( "Monitor id %s.\n", info->monitor_id_string );
 
+skip_id:
     for (i = 0; i < 4; ++i)
     {
         if (edid[54 + i * 18] || edid[54 + i * 18 + 1])
-- 
