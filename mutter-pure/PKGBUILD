prepare() {
  cd mutter

  # https://gitlab.gnome.org/GNOME/mutter/-/merge_requests/2660
  patch -Np1 -i "${srcdir}/Add-support-for-tearing.patch"
  # https://gitlab.gnome.org/GNOME/mutter/-/merge_requests/5116
  patch -Np1 -i "${srcdir}/5116.patch"
  # https://gitlab.gnome.org/GNOME/mutter/-/merge_requests/5131
  patch -Np1 -i "${srcdir}/5131.patch"
  # https://gitlab.gnome.org/GNOME/mutter/-/merge_requests/5137
  patch -Np1 -i "${srcdir}/5137.patch"
}

build() {
  local meson_options=(
    -D docs=false
    -D egl_device=true
    -D devkit=disabled
    -D installed_tests=false
    -D tests=disabled
    -D wayland_eglstream=true
  )

  CFLAGS="${CFLAGS/-O2/-O3} -fno-semantic-interposition"
  LDFLAGS+=" -Wl,-Bsymbolic-functions"

  # Inject gvdb
  export MESON_PACKAGE_CACHE_DIR="$srcdir"

  arch-meson mutter build "${meson_options[@]}"
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}

