-    else
-    {
-        list_add_tail( &monitors, &monitor->entry );
-        TRACE( "created monitor %p for source %p\n", monitor, source );
-        source->monitor_count++;
-        ctx->monitor_count++;
-    }
+
+    if (generated_edid) free( edid );
+    list_add_tail( &monitors, &monitor->entry );
+    TRACE( "created monitor %p for source %p\n", monitor, source );
+    source->monitor_count++;
