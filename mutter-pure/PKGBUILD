  'f989bc2ceb52aad3c6a23c439df3bbc672bc11d561a247d19971d30cc85ed5d42295de40f8e55b13404ed32aa44f12307c9f5b470f2e288d1c9c8329255c43bf'
  '9a4533f7ac39b2f60446c8c9f369cbaedc93e9e5150805c628363e31901909fcc1885ba9a897331521af67f78df01070fe5762971a641b02bbc3a4addd74a534'
  'e844e67fe1d692800ebc557898bd112a1f9d41bd156c9d5f79c9dc7ac31d365d4f5a9a9e9ec3d0c4d44aaeff72bad997d60366f480f5571edbcb48b058990eda'
  '5f23aca89ba51fb4077d7461635603cd45e878e5f5ff37a5a1fb5304f1c398496548e199e316b9daad0c571ece1cc9a2dca215f895bde6d9880be99a59cd443c'
)

prepare() {
  cd mutter

  # https://gitlab.gnome.org/GNOME/mutter/-/merge_requests/2660
  patch -Np1 -i "${srcdir}/Add-support-for-tearing.patch"
  # https://gitlab.gnome.org/GNOME/mutter/-/merge_requests/5116
  patch -Np1 -i "${srcdir}/5116.patch"
  # https://gitlab.gnome.org/GNOME/mutter/-/merge_requests/5131
  patch -Np1 -i "${srcdir}/5131.patch"
}

build() {
  local meson_options=(
    -D docs=false
    -D egl_device=true
    -D devkit=disabled
    -D installed_tests=false
    -D tests=disabled
    -D wayland_eglstream=true
  )

  CFLAGS="${CFLAGS/-O2/-O3} -fno-semantic-interposition"
  LDFLAGS+=" -Wl,-Bsymbolic-functions"

  # Inject gvdb
  export MESON_PACKAGE_CACHE_DIR="$srcdir"

  arch-meson mutter build "${meson_options[@]}"
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}

