source=(
  "https://gitlab.gnome.org/GNOME/gtk/-/archive/$pkgver/gtk-$pkgver.tar.gz"
  "git+https://github.com/lah7/gtk3-classic#tag=$pkgver"
  0001-Allow-disabling-legacy-Tracker-search.patch
  gtk-query-immodules-3.0.hook
)
b2sums=(
  '2e03255ce0e21b1aeb45f6d4d77e09033ab134ce2c3efb350b982df63c306c1338a5d2ebba463d0bd890d9bffe92f288e83971f00aebc943df909c6ee21cba57'
  '9c565eabf36d4db27f02ab446fc27a563519a803f29767a0ba2bf86e6d22de7a25e225880b4a06bebfb19fe39345f9df9888424a1c7389a026ab6c8f59358c7c'
  'ae371c52f24d00153037622de12a7e0026223c50fcb4b83e88138e2fd8b69a27422dfc91dae3a83c24705c57370bc9d75de4228210041c10c55482443478e240'
  '8e6a3906126749c6d853f582e3802254cdbba099c6af7190ad576eff6ea5425404a72b1b36950a87e3afdac82295cfe246003172c3e0341a73bd931a36f3b407'
)


prepare() {
  cd "gtk-$pkgver"

  # Don't try to use the old Tracker
  patch -Np1 -i "${srcdir}/0001-Allow-disabling-legacy-Tracker-search.patch"

  # Apply gtk3-classic patchset
  for patch in "${srcdir}"/gtk3-classic/*.patch; do
    patch -Np1 -i "$patch"
  done
}

build() {
  local meson_options=(
    -D colord=auto
    -D gtk_doc=false
    -D examples=false
    -D tests=false
    -D installed_tests=false
    -D introspection=true
    -D man=false
    -D demos=false
    -D tracker=false
    -D tracker3=false
    -D atk_bridge=false
  )

  CFLAGS+=" -DG_DISABLE_CAST_CHECKS"
  arch-meson "gtk-$pkgver" build "${meson_options[@]}"
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  rm "$pkgdir/usr/bin/gtk-update-icon-cache"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/gtk-3.0/settings.ini" <<END
[Settings]
gtk-icon-theme-name = Adwaita
gtk-theme-name = Adwaita
gtk-font-name = Cantarell 11
END
  install -Dm644 gtk-query-immodules-3.0.hook -t "$pkgdir/usr/share/libalpm/hooks"
}

